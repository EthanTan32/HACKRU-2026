# Reference settings only: Python does NOT automatically load .env.
# Export in the shell before extraction or starting the backend; see README.md.

# Core diagnostics works with these optional analyzers disabled.
ENABLE_OCR=0
ENABLE_DEPTH=0
ENABLE_FACE=0
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# For face, install requirements-face.txt and run from backend:
# python download_face_model.py
# Then set an absolute path to the downloaded model.
# FACE_MODEL_PATH=/absolute/path/to/backend/data/models/face_landmarker.task

# Standalone sampler defaults; pipeline analyzers use profiles below.
SAMPLE_FPS=8
MAX_FRAMES=240
FRAME_WIDTH=640

# Optional profile overrides, shown at their defaults.
# OPTICAL_FLOW_FPS=8
# OPTICAL_FLOW_WIDTH=640
# FACIAL_CONSISTENCY_FPS=8
# FACIAL_CONSISTENCY_WIDTH=640
# DEPTH_CONSISTENCY_FPS=2
# DEPTH_CONSISTENCY_WIDTH=384
# BACKGROUND_MOTION_FPS=2
# BACKGROUND_MOTION_WIDTH=384
# COLOR_CONSISTENCY_FPS=2
# COLOR_CONSISTENCY_WIDTH=384
# TEXT_CONSISTENCY_FPS=2
# TEXT_CONSISTENCY_WIDTH=1280

# Omit CLASSIFIER_PATH for diagnostics mode. Load only a trusted classifier
# whose exact feature/preprocessing contract matches this environment.
# CLASSIFIER_PATH=/absolute/path/to/backend/data/classifier.joblib
# ANOMALY_REFERENCE_PATH=/absolute/path/to/backend/data/anomaly_reference.json

# Default storage is backend/data (uploads, job database, generated artifacts).
# FORENSICS_STORAGE_DIR=/absolute/path/to/runtime/data

# Set in frontend shell before Vite starts/builds, if the API address differs.
# VITE_API_URL=http://localhost:8000
